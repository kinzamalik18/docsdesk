# Which model provider to use: "gemini" for real use, "fake" for offline tests and demos.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Model names change over time. Check https://ai.google.dev/gemini-api/docs/models for current ones.
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# Leave empty to use the in-memory store (docs are re-indexed on every start).
# Set to a Postgres URL with the pgvector extension (for example Supabase) for persistence.
DATABASE_URL=

# Shown in the UI and used in the assistant's instructions.
COMPANY_NAME=Fernbill
SAMPLE_DOCS_DIR=sample_docs/fernbill

# Retrieval tuning
TOP_K=5
MIN_SIMILARITY=0.45

# Protects upload, reindex and eval endpoints. Use a long random string.
ADMIN_TOKEN=

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
